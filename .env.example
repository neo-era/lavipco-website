# ===================================================================
# .env.example - Mẫu biến môi trường cho LAVIPCO website
# Copy file này thành .env.local rồi điền giá trị thật.
# KHÔNG commit .env.local lên git.
# ===================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lavipco?schema=public"

# --- Auth.js v5 ---
# Sinh bằng: npx auth secret  (hoặc openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth (tuỳ chọn)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloudinary (lưu trữ ảnh) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="no-reply@lavipco.com.vn"

# --- Thanh toán VNPay (sandbox mặc định) ---
VNPAY_TMN_CODE=""
VNPAY_SECRET_KEY=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/checkout/vnpay-return"

# --- Vận chuyển GHN ---
GHN_API_TOKEN=""
GHN_SHOP_ID=""

# --- Public env (lộ ra client) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=""

# --- Seed ---
# Mật khẩu admin mặc định khi chạy `npm run db:seed`
SEED_ADMIN_PASSWORD="Admin@12345"
