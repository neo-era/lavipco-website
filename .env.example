# ===================================================================
# .env.example - Mẫu biến môi trường cho LAVIPCO website
# Copy file này thành .env.local rồi điền giá trị thật.
# KHÔNG commit .env.local lên git.
# ===================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lavipco?schema=public"

# --- Auth.js v5 ---
# Sinh bằng: npx auth secret  (hoặc openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth (tuỳ chọn)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloudinary (lưu trữ ảnh) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="no-reply@lavipco.com.vn"

# --- Thanh toán VNPay ---
# 1. Đăng ký sandbox tại https://sandbox.vnpayment.vn/devreg
# 2. Lấy TMN_CODE (Terminal ID) và Hash Secret từ Merchant Admin
# 3. Endpoint sandbox dùng VNPAY_URL bên dưới; production:
#    https://pay.vnpay.vn/vpcpay.html
# 4. RETURN_URL phải đúng public URL của site (Vercel/ngrok khi dev local
#    với webhook IPN). Trang return: /checkout/vnpay-return
#    Trang IPN (server-to-server): /api/payment/vnpay-ipn (đăng ký với VNPay)
# 5. Test thẻ ATM sandbox NCB:
#    - Số thẻ: 9704198526191432198 | Chủ thẻ: NGUYEN VAN A
#    - Phát hành: 07/15 | OTP: 123456
VNPAY_TMN_CODE=""
VNPAY_SECRET_KEY=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/checkout/vnpay-return"

# --- Vận chuyển GHN ---
GHN_API_TOKEN=""
GHN_SHOP_ID=""

# --- Rate Limit (Upstash Redis - free 10k cmd/day) ---
# Đăng ký https://upstash.com → Create Database → copy URL + Token
# Khi không có → fallback in-memory (chỉ OK cho single-instance VPS)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- AI Admin Copilot (Claude API) ---
# Đăng ký https://console.anthropic.com → API Keys → Create. Nạp credit tối thiểu $5.
# Dùng cho nút "✨ AI tạo nội dung" trong admin (mô tả sản phẩm/dịch vụ/dự án,
# bài blog, meta SEO). Khi thiếu key → nút AI tự ẩn (không crash app).
ANTHROPIC_API_KEY=""
# Model mặc định Haiku 4.5 (nhanh + rẻ). Đổi claude-sonnet-4-6 nếu cần chất lượng cao.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# --- Public env (lộ ra client) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""
# Google Tag Manager ID (GTM-XXXXXXX) - optional
NEXT_PUBLIC_GTM_ID=""
# Sentry DSN (error tracking) - lấy ở sentry.io → Project → Settings → Client Keys.
# Khi thiếu → Sentry tắt hoàn toàn (defensive). Chỉ gửi lỗi ở NODE_ENV=production.
NEXT_PUBLIC_SENTRY_DSN=""

# --- Sentry source map upload (optional, để stack trace đẹp) ---
# Thiếu cũng không sao - build vẫn chạy, chỉ là stack trace bị minify.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Seed ---
# Mật khẩu admin mặc định khi chạy `npm run db:seed`
SEED_ADMIN_PASSWORD="Admin@123"
